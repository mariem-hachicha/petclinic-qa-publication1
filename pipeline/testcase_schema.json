{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cas de test PetClinic",
  "type": "object",
  "required": ["id", "requirement_id", "title", "technique", "user", "preconditions", "request", "expected"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^TC-[A-Z]+-[0-9]{2}-[0-9]{2}$" },
    "requirement_id": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "technique": { "enum": ["nominal", "classe_equivalence", "valeur_limite", "erreur", "securite"] },
    "user": { "enum": ["admin", "reception", "vet", "george", "betty", null] },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "request": {
      "type": "object",
      "required": ["method", "path", "query", "body_json"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
        "path": { "type": "string", "pattern": "^/api/" },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "body_json": { "type": ["string", "null"] }
      }
    },
    "expected": {
      "type": "object",
      "required": ["status", "body_checks"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "operator"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "pattern": "^(\\[[0-9]+\\]|[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+\\])?)(\\.[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+\\])?)*$" },
              "operator": { "enum": ["equals", "exists", "not_exists", "contains"] },
              "value": {}
            }
          }
        }
      }
    }
  }
}